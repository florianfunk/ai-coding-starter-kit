{
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run start:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(lsof:*)",
      "Bash(kill:*)",
      "Bash(npx shadcn@latest add:*)",
      "Bash(ls:*)",
      "Bash(cat:*)"
    ]
  },
  "enabledPlugins": {
    "superpowers@superpowers-dev": true,
    "frontend-design@aws-claude-code-plugins": true
  },
  "extraKnownMarketplaces": {
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers"
      }
    },
    "aws-claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "aws-solutions-library-samples/guidance-for-claude-code-with-amazon-bedrock"
      }
    }
  }
}
