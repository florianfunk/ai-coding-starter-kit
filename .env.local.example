# === Supabase (Pflicht) ===
# Projekt in EU-Region anlegen (DSGVO). Werte aus Supabase Dashboard › API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# === Supabase Service-Role (nur für Wartungs-Skripte) ===
# Wird ausschließlich von lokalen Maintenance-Skripten benutzt
# (z. B. scripts/backfill-empfaenger-normalisiert.ts). Umgeht RLS — daher
# NIE in App-Code, nie im Browser, nie committen.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# === Single-Tenant Zugangsbeschränkung ===
# Nur diese E-Mail darf sich einloggen (Single-Tenant-Garantie). Leer = jeder eingeloggte Nutzer.
STEUERAGENT_ALLOWED_EMAIL=du@deine-firma.de

# === Verschlüsselung sensibler Stammdaten (Paperless-Token) ===
# 32+ Zeichen Zufallswert. Niemals committen.
STEUERAGENT_ENCRYPTION_KEY=change_me_to_a_long_random_secret_min_32_chars
# Optional, NUR während einer Key-Rotation: vorheriger Schlüssel. decrypt()
# probiert ihn als Fallback, damit alte Daten weiter lesbar bleiben, bis sie
# mit dem neuen Schlüssel neu verschlüsselt wurden. Danach wieder entfernen.
# STEUERAGENT_ENCRYPTION_KEY_OLD=previous_secret_min_32_chars

# === Paperless SSRF-Schutz (Hardening) ===
# In Produktion werden private/interne Ziele (localhost, 10/8, 192.168/16,
# 169.254.x Metadaten …) und http blockiert. Nur setzen, wenn die Paperless-
# Instanz bewusst im privaten Netz läuft und das Risiko akzeptiert ist.
# STEUERAGENT_ALLOW_PRIVATE_PAPERLESS=false

# === KI / LLM (PROJ-5 Klassifizierung) ===
# Vercel AI Gateway (anbieterunabhängig, EU/Zero-Retention konfigurierbar).
AI_GATEWAY_API_KEY=your_ai_gateway_key_here
# Modell als provider/model String (über Gateway).
STEUERAGENT_LLM_MODEL=anthropic/claude-haiku-4-5
# (PROJ-33, optional) Nebenläufigkeit der Massen-Klassifizierung: wie viele
# Buchungen gleichzeitig verarbeitet werden (LLM-Call + DB-Update). Default 5,
# geklemmt auf 1..20. Konservativ wegen LLM-Rate-Limits — nur erhöhen, wenn das
# Provider-Rate-Limit es zulässt.
# KLASSIFIZIERUNG_CONCURRENCY=5

# === Web-Recherche-Fallback (PROJ-5, optional) ===
# Wenn die LLM-Klassifizierung unsicher ist (Konfidenz unter Schwellwert),
# wird der Empfänger über Firecrawl im Web kurz nachgeschlagen und das
# Ergebnis als Kontext erneut ans LLM gegeben. Ohne Key: kein Fallback,
# unsichere Buchungen landen wie bisher in der Prüfliste.
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key_here

# === E-Mail-Fristen-Erinnerung (PROJ-32, optional) ===
# Aktive E-Mail-Erinnerung an USt-VA-Fristen über einen Vercel-Cron, der
# GET /api/cron/fristen-erinnerung täglich aufruft.
#
# OHNE RESEND_API_KEY versendet das Feature NICHTS (no-op + Log) — der
# Cron-Lauf bleibt fehlerfrei. Scharfschaltung = Key + verifizierte
# Absender-Domain bei Resend setzen.
#
# Resend-API-Key (https://resend.com). Leer = kein Versand.
RESEND_API_KEY=re_your_resend_api_key_here
# Absender-Adresse (muss bei Resend verifiziert sein). Default: resend.dev-Test.
FRISTEN_MAIL_FROM=STEUERAGENT <noreply@deine-firma.de>
# Geheimnis zum Schutz des Cron-Endpoints. Vercel sendet es als
# "Authorization: Bearer $CRON_SECRET". Ohne gesetztes Secret ist der
# Endpoint geschlossen (401). Langer Zufallswert, niemals committen.
CRON_SECRET=change_me_to_a_long_random_secret
# Basis-URL des Tools für den Link in der Mail (ohne abschließenden Slash).
NEXT_PUBLIC_APP_URL=https://deine-firma.example.de
